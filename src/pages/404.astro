---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | KevinRuffe.com" description="Page not found">
  <section class="not-found">
    <h1>404</h1>
    <p>
      The page you were looking for could not be found.
      <a href="/">Return home</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 1rem;
    justify-items: center;
    padding: 4rem 0;
    text-align: center;
  }
</style>
