---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPosts from "../components/blogPosts.astro";
import BlogPaginationActions from "../components/blogPaginationActions";
import { sortBlogPosts } from "../utils/blog";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = sortBlogPosts(await getCollection("blog"));

  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page }: Props = Astro.props;

const title =
  page.currentPage === 1
    ? "KevinRuffe.com"
    : `Page ${page.currentPage} | KevinRuffe.com`;
---

<BaseLayout title={title} description="Blog posts by Kevin Ruffe">
  <section>
    <h1>Thoughts</h1>
    <p>
      Blog posts, links to articles or videos I'm reading, reviews of this and
      that. This is a space for me to unload my mind.
    </p>
    <p>You can find all the topics I've covered <a href="/tags/">here</a>.</p>
    <BlogPosts posts={page.data} />
    <BlogPaginationActions page={page} />
  </section>
</BaseLayout>
