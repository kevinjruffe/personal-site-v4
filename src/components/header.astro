---
import Logo from "../assets/logo.png";
import SiteNav from "./siteNav";
import Styles from "./header.module.css";
import { Image } from "astro:assets";
---

<header class={Styles["site-header"]}>
  <div class={Styles["site-header-inner"]}>
    <a class={Styles["site-title"]} href="/" aria-label="KevinRuffe.com home">
      <Image
        src={Logo}
        alt="KevinRuffe.com logo"
        width={180}
        height={120}
        class={Styles["site-logo"]}
      />
    </a>
    <SiteNav client:idle />
  </div>
</header>
