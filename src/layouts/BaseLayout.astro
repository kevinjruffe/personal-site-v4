---
import { Font, Image } from "astro:assets";
import logo from "../assets/logo.png";
import Footer from "../components/footer";
import Header from "../components/header";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "KevinRuffe.com",
  description = "Personal website of Kevin Ruffe",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-newsreader" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <Header client:load>
        <Image
          src={logo}
          alt="KevinRuffe.com logo"
          width={180}
          height={120}
          class="site-logo"
        />
      </Header>
      <main class="site-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  :global(html) {
    box-sizing: border-box;
  }

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: inherit;
  }

  :global(body) {
    font-family: var(--font-newsreader), serif;
    margin: 0;
    min-height: 100vh;
  }

  .site-logo {
    display: block;
    height: auto;
    max-height: 120px;
    width: auto;
  }
</style>
